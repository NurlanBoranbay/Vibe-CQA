# Copy to .env (git-ignored). Everything is optional: without keys the app still opens with the
# evaluated DEV calls; a model is needed only to run new evaluations. Keys can also be added in the UI
# («Модели и ключи», admin role).

# Organizers' dataset API: the GET link from «Открыть GET для DEV» WITHOUT the trailing &group_id=...
# The app appends &group_id=<DEV | control id> when you import by group_id.
ORGANIZER_API=https://ec88f21f1accecf38e20095a9fe175.a5.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/11/workflows/b3d2a68006a24662be2b721454cb4e00/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=5Sog2MThgCRTlk3HObv70LRmRk6u7IOwzlwMpe804qo

# Default model: Gemma 4 26B-A4B (thinking) on a vLLM server (OpenAI-compatible).
# Locally: http://127.0.0.1:18887/v1 · in Docker: http://host.docker.internal:18887/v1 (set in docker-compose.yml)
# GEMMA_BASE_URL=http://127.0.0.1:18887/v1
# Or point the default evaluator at any provider spec, e.g. openrouter:<vendor/model>
# CQA_PROVIDER=

# Hosted providers (any one is enough)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=          # for compat:<model>@<base_url>

# Parallelism: calls evaluated at once / model requests in flight
# CQA_CALLS_PARALLEL=12
# CQA_LLM_PARALLEL=32

# Spending guard for paid APIs (USD per server process)
# CQA_BUDGET_USD=2.0
